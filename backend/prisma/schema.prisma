generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS DE ROLES JERÁRQUICOS (CORPORATIVO Y SUCURSAL)
// -------------------------------------------------------------
enum Role {
  // Nivel Plataforma
  SUPERADMIN
  
  // Nivel Corporativo / Empresa
  CLIENTE_ADMIN          // Dueño general de la empresa / franquicia
  CONTABILIDAD_CORP      // Finanzas centrales, costos y precios maestros
  COMPRADOR_CORP         // Abastecimiento corporativo y órdenes de compra (PO)
  ALMACENISTA_CENTRAL    // Gestor del almacén central / CEDIS
  
  // Nivel Punto de Venta / Sucursal Local
  ADMIN_SUCURSAL         // Gerente de tienda física
  FINANZAS_SUCURSAL      // Auxiliar contable de tienda (arqueos y caja chica)
  CAJERO                 // Operador de cobro y caja registradora
  VENDEDOR               // Asesor de mostrador, preventa y cotizaciones con reserva
  ALMACENISTA_SUCURSAL   // Encargado de trastienda, traspasos y mermas locales
  MARKETING              // Diseñador y gestor de campañas y banners publicitarios
  
  // Nivel Externo
  CLIENTE_FINAL          // Comprador web en catálogo digital B2B/B2C
}

enum MovementType {
  ENTRADA_COMPRA       // Entrada por recepción de Orden de Compra
  ENTRADA_TRASPASO     // Entrada recibida desde otra sucursal o CEDIS
  ENTRADA_AJUSTE       // Entrada manual por corrección de inventario
  SALIDA_VENTA         // Salida por venta confirmada en mostrador o pedido
  SALIDA_MERMA         // Merma, rotura o daño en tienda
  SALIDA_AJUSTE        // Ajuste negativo por conteo físico
  SALIDA_TRASPASO      // Envío hacia otra sucursal
}

enum PurchaseOrderStatus {
  BORRADOR
  EMITIDA
  EN_TRANSITO
  RECIBIDA_PARCIAL
  RECIBIDA_TOTAL
  CANCELADA
}

enum QuotationStatus {
  PENDIENTE            // Creada sin reserva
  RESERVADA            // Con reserva temporal activa de stock
  CONVERTIDA           // Facturada / convertida a venta
  EXPIRADA             // Tiempo de reserva vencido
  CANCELADA            // Cancelada por el vendedor o cliente
}

enum CashCutStatus {
  ABIERTO              // Caja operando en el día
  CERRADO              // Cajero finalizó arqueo
  AUDITADO_LOCAL       // Finanzas de sucursal validó
  AUDITADO_CORP        // Contabilidad corporativa cerró formalmente
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MIXTO
}

// -------------------------------------------------------------
// EMPRESAS Y SUCURSALES (MULTI-POS CON CANDADO)
// -------------------------------------------------------------
model Business {
  id              String    @id @default(uuid())
  name            String
  tax_id          String?
  contact_email   String
  contact_phone   String?
  is_locked       Boolean   @default(false)
  lock_reason     String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  users           User[]
  branches        Branch[]

  @@map("businesses")
}

model Branch {
  id                  String          @id @default(uuid())
  business_id         String?
  name                String          // Ej. "Sucursal Centro", "Sucursal Plaza Norte"
  code                String          @unique // Ej. "POS-01"
  address             String?
  phone               String?
  is_locked           Boolean         @default(false)
  lock_reason         String?
  min_consumption     Decimal         @default(0) @db.Decimal(12, 2)
  current_month_sales Decimal         @default(0) @db.Decimal(12, 2)
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  business            Business?       @relation(fields: [business_id], references: [id])
  users               User[]
  sales               Sale[]
  quotations          Quotation[]
  orders              Order[]
  standbyTickets      StandbyTicket[]
  purchaseOrders      PurchaseOrder[]
  cashCuts            CashCut[]
  branchExpenses      BranchExpense[]

  @@map("branches")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password_hash      String
  full_name          String
  role               Role                @default(CLIENTE_FINAL)
  business_id        String?
  branch_id          String?             // Sucursal a la que pertenece (para roles locales)
  is_locked          Boolean             @default(false)
  lock_reason        String?
  is_active          Boolean             @default(true)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  business           Business?           @relation(fields: [business_id], references: [id])
  branch             Branch?             @relation(fields: [branch_id], references: [id])
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  quotations         Quotation[]
  orders             Order[]
  standbyTickets     StandbyTicket[]
  purchaseOrders     PurchaseOrder[]
  cashCutsCreated    CashCut[]           @relation("CashCutUser")
  cashCutsAudited    CashCut[]           @relation("CashCutAuditor")
  priceHistories     PriceHistory[]
  branchExpenses     BranchExpense[]

  @@map("users")
}

// -------------------------------------------------------------
// GASTOS LOCALES DE SUCURSAL (CAJA CHICA)
// -------------------------------------------------------------
model BranchExpense {
  id          String   @id @default(uuid())
  branch_id   String
  user_id     String   // Registrado por Finanzas de Sucursal / Gerente
  concept     String   // Ej. "Compra artículos de limpieza", "Papelería rollos POS"
  amount      Decimal  @db.Decimal(12, 2)
  receipt_url String?  // Foto del ticket de compra
  created_at  DateTime @default(now())

  branch      Branch   @relation(fields: [branch_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@map("branch_expenses")
}

// -------------------------------------------------------------
// PRODUCTOS, KARDEX, VENTAS, COTIZACIONES Y CORTES DE CAJA
// -------------------------------------------------------------
model Product {
  id                 String              @id @default(uuid())
  sku                String              @unique
  qr_code            String              @unique
  name               String
  description        String?
  category           String              @default("General")
  price              Decimal             @db.Decimal(12, 2) // Modificable solo por Contabilidad Corp
  cost               Decimal             @db.Decimal(12, 2) // Modificable solo por Contabilidad Corp
  
  stock              Int                 @default(0) // Físico
  reserved_stock     Int                 @default(0) // Comprometido en cotizaciones activas
  in_transit_stock   Int                 @default(0) // En camino por PO
  
  safety_stock       Int                 @default(5)
  min_stock          Int                 @default(10)
  max_stock          Int                 @default(100)
  lead_time_days     Int                 @default(3)

  image_url          String?
  is_active          Boolean             @default(true)
  last_sale_at       DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  quotationItems     QuotationItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  priceHistories     PriceHistory[]

  @@map("products")
}

model PriceHistory {
  id             String   @id @default(uuid())
  product_id     String
  old_price      Decimal  @db.Decimal(12, 2)
  new_price      Decimal  @db.Decimal(12, 2)
  old_cost       Decimal  @db.Decimal(12, 2)
  new_cost       Decimal  @db.Decimal(12, 2)
  changed_by_id  String
  reason         String?
  created_at     DateTime @default(now())

  product        Product  @relation(fields: [product_id], references: [id])
  changedBy      User     @relation(fields: [changed_by_id], references: [id])

  @@map("price_history")
}

model CashCut {
  id                  String         @id @default(uuid())
  branch_id           String
  user_id             String         // Cajero
  audited_by_user_id  String?        // Finanzas de Sucursal / Gerente
  
  initial_cash        Decimal        @db.Decimal(12, 2)
  cash_sales          Decimal        @default(0) @db.Decimal(12, 2)
  card_sales          Decimal        @default(0) @db.Decimal(12, 2)
  transfer_sales      Decimal        @default(0) @db.Decimal(12, 2)
  mixed_sales         Decimal        @default(0) @db.Decimal(12, 2)
  total_sales         Decimal        @default(0) @db.Decimal(12, 2)
  
  expected_cash       Decimal        @default(0) @db.Decimal(12, 2)
  actual_cash_counted Decimal?       @db.Decimal(12, 2)
  difference          Decimal?       @db.Decimal(12, 2)
  notes               String?
  status              CashCutStatus  @default(ABIERTO)
  opened_at           DateTime       @default(now())
  closed_at           DateTime?

  branch              Branch         @relation(fields: [branch_id], references: [id])
  user                User           @relation("CashCutUser", fields: [user_id], references: [id])
  auditor             User?          @relation("CashCutAuditor", fields: [audited_by_user_id], references: [id])
  sales               Sale[]

  @@map("cash_cuts")
}

model Sale {
  id             String        @id @default(uuid())
  invoice_number String        @unique
  branch_id      String?
  user_id        String        // Cajero
  cash_cut_id    String?
  quotation_id   String?       @unique
  customer_name  String?       @default("Público General")
  total          Decimal       @db.Decimal(12, 2)
  payment_method PaymentMethod @default(EFECTIVO)
  amount_paid    Decimal       @default(0) @db.Decimal(12, 2)
  change_given   Decimal       @default(0) @db.Decimal(12, 2)
  created_at     DateTime      @default(now())

  items          SaleItem[]
  user           User          @relation(fields: [user_id], references: [id])
  branch         Branch?       @relation(fields: [branch_id], references: [id])
  quotation      Quotation?    @relation(fields: [quotation_id], references: [id])
  cashCut        CashCut?      @relation(fields: [cash_cut_id], references: [id])

  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid())
  sale_id    String
  product_id String
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  sale       Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id])

  @@map("sale_items")
}

model Quotation {
  id                     String          @id @default(uuid())
  folio                  String          @unique // Ej. "COT-2026-0042"
  branch_id              String?
  user_id                String          // Vendedor
  client_name            String
  client_contact         String?
  total                  Decimal         @db.Decimal(12, 2)
  status                 QuotationStatus @default(PENDIENTE)
  reserves_stock         Boolean         @default(false)
  reservation_expires_at DateTime?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  items                  QuotationItem[]
  sale                   Sale?
  user                   User            @relation(fields: [user_id], references: [id])
  branch                 Branch?         @relation(fields: [branch_id], references: [id])

  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotation_id String
  product_id   String
  quantity     Int
  unit_price   Decimal   @db.Decimal(12, 2)
  subtotal     Decimal   @db.Decimal(12, 2)

  quotation    Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [product_id], references: [id])

  @@map("quotation_items")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  product_id     String
  type           MovementType
  quantity       Int
  previous_stock Int
  current_stock  Int
  reference_doc  String?
  reason         String?
  user_id        String
  created_at     DateTime     @default(now())

  product        Product      @relation(fields: [product_id], references: [id])
  user           User         @relation(fields: [user_id], references: [id])

  @@map("inventory_movements")
}

model PurchaseOrder {
  id                     String              @id @default(uuid())
  po_number              String              @unique
  supplier_name          String
  supplier_contact       String?
  branch_id              String?
  user_id                String
  status                 PurchaseOrderStatus @default(BORRADOR)
  total                  Decimal             @db.Decimal(12, 2)
  expected_delivery_date DateTime?
  received_at            DateTime?
  notes                  String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  branch                 Branch?             @relation(fields: [branch_id], references: [id])
  user                   User                @relation(fields: [user_id], references: [id])
  items                  PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String        @id @default(uuid())
  purchase_order_id  String
  product_id         String
  quantity_ordered   Int
  quantity_received  Int           @default(0)
  unit_cost          Decimal       @db.Decimal(12, 2)
  subtotal           Decimal       @db.Decimal(12, 2)

  purchaseOrder      PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [product_id], references: [id])

  @@map("purchase_order_items")
}

model StandbyTicket {
  id             String   @id @default(uuid())
  reference_name String
  cart_data      Json
  branch_id      String?
  user_id        String
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])
  branch         Branch?  @relation(fields: [branch_id], references: [id])

  @@map("standby_tickets")
}

model Order {
  id               String      @id @default(uuid())
  order_number     String      @unique
  user_id          String
  branch_id        String?
  status           OrderStatus @default(PENDIENTE)
  total            Decimal     @db.Decimal(12, 2)
  shipping_address String?
  notes            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  user             User        @relation(fields: [user_id], references: [id])
  branch           Branch?     @relation(fields: [branch_id], references: [id])
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Banner {
  id               String   @id @default(uuid())
  title            String
  subtitle         String?
  badge            String?
  discount_tag     String?
  image_url        String
  category_target  String?
  position         String   @default("MOSAIC_PROMO") // STRIP_BANNER, FLASH_OFFER, MOSAIC_PROMO
  background_color String?  @default("#ea580c")
  link_url         String?
  is_active        Boolean  @default(true)
  order            Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("banners")
}
